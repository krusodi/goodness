rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection endpoint
    match /test/{testId} {
      allow read, write: if true;
    }

    // Students collection (Realtime multi-device sync for classroom management)
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Merit and Demerit records (Realtime multi-device sync)
    match /records/{recordId} {
      allow read, write: if true;
    }

    // School and app settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default deny catch-all for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
